#!/usr/bin/env node

const { runAssistantCliWrapper } = require("./lib/assistant-cli-wrapper");
const { createVisualToolUsagePrompt } = require("./lib/claude-session-prompts");
const { createCodexHookRuntime } = require("./lib/codex-hook-preflight");
const {
  createCodexVisualMcpRuntimeArgs,
} = require("./lib/codex-visual-mcp-runtime");

function main() {
  let hookRuntimeDescription = "hooks=not-checked";
  const visualToolUsagePrompt = createVisualToolUsagePrompt();

  runAssistantCliWrapper({
    binaryName: "codex",
    displayName: "Codex CLI",
    traceLabel: "codex-wrapper",
    createRuntimeArgs: ({ realBinary, originalPath, publishStatusUpdate }) => {
      const hookRuntime = createCodexHookRuntime(
        realBinary,
        originalPath,
        publishStatusUpdate,
      );

      hookRuntimeDescription = hookRuntime.description;
      const visualMcpRuntimeArgs = createCodexVisualMcpRuntimeArgs();

      if (visualToolUsagePrompt.trim().length === 0) {
        return [...hookRuntime.runtimeArgs, ...visualMcpRuntimeArgs];
      }

      return [
        ...hookRuntime.runtimeArgs,
        ...visualMcpRuntimeArgs,
        "-c",
        `developer_instructions=${JSON.stringify(visualToolUsagePrompt)}`,
      ];
    },
    describeRuntime: () => {
      const visualPrompt =
        visualToolUsagePrompt.trim().length > 0 ? "present" : "none";
      const visualMcp =
        createCodexVisualMcpRuntimeArgs().length > 0
          ? "session-scoped"
          : "user-scope";

      return `${hookRuntimeDescription} visualMcp=${visualMcp} visualPrompt=${visualPrompt}`;
    },
    status: {
      starting: {
        providerId: "codex",
        state: "working",
        line: "Codex CLI 세션 실행 중이에요...!",
        activity: "Codex CLI 세션 시작하는 중",
        task: "Running Codex CLI in the active terminal",
        intensity: "medium",
      },
      disconnected: {
        providerId: "codex",
        state: "disconnected",
        line: "Codex CLI 세션이 종료돼서 지금은 미연결 상태예요...!",
        activity: "연결 대기 중",
        task: "Waiting for Codex CLI to start",
        intensity: "low",
      },
      error: {
        providerId: "codex",
        state: "error",
        line: "Codex CLI 세션이 에러로 끝낫어요...!",
        activity: "세션 복구가 필요한 상태",
        task: "Codex CLI command exited with an error",
        intensity: "high",
      },
    },
  });
}

main();
